configuration{
    modes: "drun,run,window,combi,calc";
    icon-theme: "Oranchelo";
    show-icons: true;
    terminal: "alacritty";
    drun-display-format: "{icon} {name}";
    location: 0;
    disable-history: false;
    hide-scrollbar: true;
    display-combi: " 🖥️  All ";
    display-run: " 🏃  Run ";
    display-window: " 🪟  Window";
    display-drun: " 🚀  Apps ";
    sidebar-mode: true;
    display-calc: " 🧮  Calc ";
}

@theme "catppuccin-mocha"
